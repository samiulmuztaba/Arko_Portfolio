    </pre>
    <div class="screen">
        <div class="terminal">
            <div class="terminal-line">
                <span class="prompt">arko@portfolio:~$</span> help
            </div>

            <div class="help-text">
                <div>
                    <span>whoami - who I am</span>
                </div>
                <div>
                    <span>skills</span> - what I can do
                </div>
                <div>
                    <span>projects</span> - what I've done with what I can do
                </div>
                <div>
                    <span>achievements</span> - what I've achieved
                </div>
                <div>
                    <span>blog</span> - my articles
                </div>
            </div>
            <div class="input-line">
                <span class="prompt">~$ </span>
                <input type="text" aria-label="Terminal command">
                <br>
            </div>
        </div>
    </div>
    </div>


    </div>
</BaseLayout>

<style>
	.wrapper {
		display: flex;
		justify-content: center;
		gap: 2rem;
	}

	.name-banner,
	.crt-computer {
		/* font-family: "Courier New", monospace; */
		font-size: 1.8rem;
		line-height: 1;
		letter-spacing: 0;
	}

	.name-banner {
		color: var(--color-text);
	}

	.name-banner span {
		color: var(--color-phosphor);
	}

	.crt-computer {
		color: var(--color-hardware);
		margin-top: 4rem;
        position: relative;
	}

    .help-text{
        font-size: 90%;
        color: var(--color-text-muted);
        padding: 0.5rem 1rem;
    }

	.input-line { 
        display: flex; 
        align-items: center; 
        margin-top: 0.35rem; 
        gap:0.2rem;
    } 
    
    .input-line input { 
        flex: 1; 
        min-width: 0; 
        padding: 0; 
        border: none; 
        outline: none; 
        background: transparent; 
        color: var(--color-phosphor); 
        font-family: var(--font-terminal); 
        font-size: inherit; 
        line-height: inherit; 
        caret-color: var(--color-phosphor); 
        caret-shape: block; 
    }
    .screen {
        width: 15rem;
        height: 10rem;

        padding: 1.25rem;

        position: absolute;
        background: var(--color-bg);

        top: 4.5rem;
        left: 4.5rem;

        box-shadow:
            inset 0 0 0 2px var(--color-border),
            /* inset 0 0 25px rgb(128 255 128 / 5%); */
        
        overflow: scroll;
    }

    .screen::after {
    content: "";
    position: absolute;
    inset: 0;

    pointer-events: none;

    background:
        repeating-linear-gradient(
            to bottom,
            transparent 0,
            transparent 2px,
            rgb(128 255 128 / 3%) 3px
        );
}

    .screen::-webkit-scrollbar {
        display: none;
    }

    .terminal {
        height: 100%;

        color: var(--color-text);
        font-size: 0.85rem;
        line-height: 1.2;

        
    }

    .prompt, .help span {
        color: var(--color-phosphor);
    }
</style>