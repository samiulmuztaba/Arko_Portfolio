<style>
	.wrapper {
		display: flex;
		justify-content: center;
		gap: 2rem;
	}

	.name-banner,
	.crt-computer {
		/* font-family: "Courier New", monospace; */
		font-size: 1.8rem;
		line-height: 1;
		letter-spacing: 0;
	}

	.name-banner {
		color: var(--color-text);
	}

	.name-banner span {
		color: var(--color-phosphor);
	}

	.crt-computer {
		color: var(--color-hardware);
		margin-top: 4rem;
	}

	.in-comp {
		color: var(--color-phosphor);
		font-size: 54%;
        font-family: "IBM Plex Mono"
	}

	.crt-computer input {
		width: 52%;
		background: none;
		border: none;
		color: var(--color-phosphor);
		font-family: "Courier New", monospace;
		font-size: 59.58%;
		outline: none;
		caret-color: var(--color-phosphor);
        caret-shape: block;
	}
</style>